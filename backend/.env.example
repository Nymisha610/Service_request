# Optional overrides. The app reads real environment variables (it does not load .env files itself).
# Comma-separated list of browser origins allowed to call this API (no trailing slash).
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Where requests are stored. If the file cannot be written, the API falls back to memory.
DATA_FILE=data/requests.json
